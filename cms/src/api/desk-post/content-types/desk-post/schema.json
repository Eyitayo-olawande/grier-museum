{
  "kind": "collectionType",
  "collectionName": "desk_posts",
  "info": {
    "singularName": "desk-post",
    "pluralName": "desk-posts",
    "displayName": "From the Desk of the House Governor"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "date": {
      "type": "date"
    },
    "author": {
      "type": "string"
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
