{
  "kind": "collectionType",
  "collectionName": "archive_items",
  "info": {
    "singularName": "archive-item",
    "pluralName": "archive-items",
    "displayName": "Archive Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Photo",
        "Video",
        "Document",
        "Artefact"
      ],
      "default": "Photo"
    },
    "era": {
      "type": "enumeration",
      "enum": [
        "Colonial",
        "Post-War",
        "Independence",
        "Modern"
      ]
    },
    "year": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "tags": {
      "type": "component",
      "component": "shared.label",
      "repeatable": true
    },
    "credit": {
      "type": "string"
    },
    "collection": {
      "type": "string"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "videoUrl": {
      "type": "string"
    }
  }
}
