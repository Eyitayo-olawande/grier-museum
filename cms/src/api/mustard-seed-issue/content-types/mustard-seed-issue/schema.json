{
  "kind": "collectionType",
  "collectionName": "mustard_seed_issues",
  "info": {
    "singularName": "mustard-seed-issue",
    "pluralName": "mustard-seed-issues",
    "displayName": "Mustard Seed Issue"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "year": {
      "type": "integer",
      "required": true
    },
    "volume": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "excerpt": {
      "type": "text"
    },
    "pieces": {
      "type": "integer"
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
