{
  "kind": "collectionType",
  "collectionName": "profiles",
  "info": {
    "singularName": "profile",
    "pluralName": "profiles",
    "displayName": "Notable Grierson"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "shortName": {
      "type": "string",
      "required": true
    },
    "surname": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "shortName",
      "required": true
    },
    "era": {
      "type": "enumeration",
      "enum": [
        "Colonial",
        "Post-War",
        "Independence",
        "Modern"
      ]
    },
    "schoolNumber": {
      "type": "string"
    },
    "set": {
      "type": "integer"
    },
    "fields": {
      "type": "component",
      "component": "shared.label",
      "repeatable": true
    },
    "heroTags": {
      "type": "component",
      "component": "shared.label",
      "repeatable": true
    },
    "distinctions": {
      "type": "component",
      "component": "shared.label",
      "repeatable": true
    },
    "achievements": {
      "type": "component",
      "component": "shared.label",
      "repeatable": true
    },
    "bio": {
      "type": "richtext",
      "required": true
    },
    "pullQuote": {
      "type": "component",
      "component": "shared.quote",
      "repeatable": false
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
