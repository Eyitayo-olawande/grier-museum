{
  "kind": "collectionType",
  "collectionName": "newsletter_issues",
  "info": {
    "singularName": "newsletter-issue",
    "pluralName": "newsletter-issues",
    "displayName": "Newsletter Issue"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "headline": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "headline",
      "required": true
    },
    "season": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "body": {
      "type": "richtext"
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    }
  }
}
